<!-- Cream page background -->
<div aria-hidden="true" class="fixed inset-0" style="z-index:-30; background:#f4efe6;"></div>

<!--
  Oxford painting — NOT fixed, sits behind the top of the page only.
  Uses the existing oxford-bg.jpg with painterly CSS filters.
  As the user scrolls down, the painting scrolls away naturally,
  leaving clean cream behind for the publications section.
-->
<div
  aria-hidden="true"
  style="
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 100vh;
    z-index: -20;
    overflow: hidden;
    pointer-events: none;
  "
>
  <!-- The actual photo, covering bottom 65% of the viewport height -->
  <div style="
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 72%;
    background: url('/img/oxford-bg.jpg') center 55% / cover no-repeat;
    filter: saturate(0.55) brightness(1.12) contrast(0.78) sepia(0.22);
  "></div>

  <!-- Cream sky fade — strong at top, transparent at bottom -->
  <div style="
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #f4efe6 0%,
      #f4efe6 55%,
      rgba(244,239,230,0.96) 65%,
      rgba(244,239,230,0.80) 75%,
      rgba(244,239,230,0.45) 86%,
      rgba(244,239,230,0.10) 95%,
      transparent 100%
    );
  "></div>

  <!-- Soft left/right vignette -->
  <div style="
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(244,239,230,0.50) 0%,
      transparent 18%,
      transparent 82%,
      rgba(244,239,230,0.50) 100%
    );
  "></div>
</div>
