<!-- Soft watercolour-style gradient — fades from muted sage/green at the very top to warm cream -->
<div
  aria-hidden="true"
  class="fixed inset-0"
  style="
    z-index: -20;
    background:
      radial-gradient(ellipse 120% 60% at 50% -10%, rgba(90,130,100,0.22) 0%, transparent 65%),
      radial-gradient(ellipse 80% 40% at 15% 20%, rgba(120,160,120,0.12) 0%, transparent 55%),
      radial-gradient(ellipse 60% 30% at 85% 15%, rgba(100,140,100,0.10) 0%, transparent 50%),
      #f4efe6;
  "
></div>

<!-- Subtle vignette at the very bottom to ground the page -->
<div
  aria-hidden="true"
  class="fixed inset-x-0 bottom-0 h-40 pointer-events-none"
  style="z-index: -18; background: linear-gradient(to top, rgba(180,160,120,0.08), transparent);"
></div>
